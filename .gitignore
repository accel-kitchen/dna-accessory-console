# KiCad local state and caches
*.kicad_prl
fp-info-cache
*-backups/
*.lck
_autosave-*
*.bak

# Installers, vendor zips (the unpacked libraries in lib/ are tracked)
lib/*.exe
lib/*.zip

# Generated by the gen/ scripts; recreate them with the steps in design/README.md
gen/_deps/
gen/_runs/
gen/__pycache__/
__pycache__/

# Backups of earlier revisions (git history keeps the current ones) and manufacturing output
design/pre-*/
fusion/

# Office lock files
~$*
